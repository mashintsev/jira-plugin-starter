{
  "name": "com.jira.plugins.jira-plugin-starter",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Jira Plugin Starter - Frontend",
  "scripts": {
    "build": "webpack --config webpack.config.cjs  --mode=development --stats-error-details",
    "build:prod": "webpack --config webpack.config.cjs --mode=production",
    "analyze": "webpack --config webpack.config.cjs --mode=production --analyze",
    "lint": "eslint '*/**/*.{js,ts,tsx}' --fix"
  },
  "browserslist": [
    "extends @atlassian/browserslist-config-server"
  ],
  "babel": {
    "presets": [
      "@babel/react",
      "@babel/typescript",
      [
        "@babel/env",
        {
          "modules": false
        }
      ]
    ],
    "plugins": [
      [
        "@babel/plugin-transform-react-jsx",
        {
          "runtime": "automatic",
          "importSource": "@compiled/react"
        }
      ],
      [
        "@compiled/babel-plugin",
        {
          "transformerBabelPlugins": [
            "@atlaskit/tokens/babel-plugin"
          ]
        }
      ]
    ],
    "assumptions": {
      "setPublicClassFields": false
    }
  },
  "packageManager": "pnpm@10.20.0",
  "devDependencies": {
    "@atlaskit/eslint-plugin-design-system": "^16.16.0",
    "@atlaskit/eslint-plugin-ui-styling-standard": "^3.0.4",
    "@atlassian/browserslist-config-server": "^0.3.2",
    "@babel/core": "^7.29.13",
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@compiled/babel-plugin": "^3.0.4",
    "@compiled/babel-plugin-strip-runtime": "^3.0.3",
    "@compiled/eslint-plugin": "^0.20.2",
    "@compiled/webpack-loader": "^1.1.1",
    "@tanstack/eslint-plugin-query": "^5.106.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "atlassian-webresource-webpack-plugin": "^7.0.1",
    "babel-loader": "^10.1.1",
    "browserslist": "^4.29.5",
    "clean-webpack-plugin": "^4.0.0",
    "css-loader": "^7.1.5",
    "eslint": "10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-xo": "^7.0.0",
    "eslint-config-xo-react": "^0.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-security": "^4.2.1",
    "inspectpack": "^4.7.1",
    "mini-css-extract-plugin": "^2.10.2",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "webpack": "^5.106.2",
    "webpack-bundle-analyzer": "^5.4.1",
    "webpack-cli": "^7.3.1",
    "webpack-stream": "^7.0.0",
    "webpackbar": "^7.0.0"
  },
  "dependencies": {
    "@atlaskit/tokens": "^20.9.0",
    "@atlassian/wrm-react-i18n": "^4.2.0",
    "@compiled/react": "^2.0.0",
    "@tanstack/react-query": "^5.106.1",
    "ky": "^2.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
